# Upstash Redis Singapore Region (Primary Datastore & State Machine)
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://sensible-ox-33433.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Alternative Vercel KV environment variables (Auto-populated if using Vercel KV Integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Administrative Portal Authentication Key (Protects /api/admin/* endpoints)
ADMIN_SECRET=norton_admin_secret_2026

# Meta Conversions API (CAPI) v22.0 Integration (GEM Center Lead Events)
META_PIXEL_ID=your_meta_pixel_id_here
META_CAPI_ACCESS_TOKEN=your_meta_system_user_access_token_here
EVENT_SOURCE_URL=https://norton-kickoff-event.vercel.app

# Google Sheets ERP Real-time Synchronizer (26-Column Formatted Webhook)
# Google Apps Script Webhook URL deployed with doGet/doPost
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_gas_deployment_id/exec

# Runtime Environment
NODE_ENV=production
